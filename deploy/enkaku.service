[Unit]
Description=Enkaku device farm core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enkaku
Group=enkaku
# USB devices need access to /dev/bus/usb — add the user to the plugdev group
# and install a udev rule for the device vendors you use.
SupplementaryGroups=plugdev
Environment=ENKAKU_DATA_DIR=/var/lib/enkaku
Environment=ENKAKU_BIND=0.0.0.0
Environment=ENKAKU_PORT=7700
# Server mode requires TLS: use a reverse proxy (external) or your own certificate.
Environment=ENKAKU_TLS_MODE=external
WorkingDirectory=/opt/enkaku
ExecStart=/usr/local/bin/bun run packages/core/src/index.ts
Restart=on-failure
RestartSec=5

# Basic hardening — the core still needs to write to the data dir and reach USB.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/enkaku

[Install]
WantedBy=multi-user.target
