# rust / tauri
# Anchored to the crates that actually build, NOT a bare `target/`: a bare
# pattern matches at ANY depth, and it was silently swallowing
# `packages/studio/src/components/target/` — four real source files
# (`TargetPicker.tsx`, `useTargetSelection.ts` and their tests, plan 104) that
# `git ls-files` reported as untracked. A fresh clone would not have built.
/apps/desktop/src-tauri/target/
/refs/tikmatrix-desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/gen/schemas/

# data dev
.dev-data/
# Stray per-test data dirs (a subagent left one under packages/core once).
**/.dev-data-*/
.dev-cloud/
.dev-agent/
.agent-data/

# release build
*.gen.ts
release/
# Built by scripts/build-packs.ts from plugins/*/src — an artifact, never a source.
packages/core/packs/


refs/

# Belt-and-braces: the workspace content driver's old relative default (plan 115). The default is
# absolute now, but a stale checkout or an older branch can still produce this at the repo root.
.enkaku-workspace-content/
dev.log
