<resources>
    <string name="app_name">Enkaku Guest Agent</string>
    <string name="status_explanation">This device is managed by an Enkaku device farm. The screen is read-only: everything here is driven by the host over adb.</string>
    <string name="status_no_secrets">The pairing token and the proxy password never appear on this screen.</string>
    <string name="switch_keyboard">Switch keyboard</string>
    <string name="keyboard_not_available">Enkaku keyboard is not enabled on this device yet.</string>
    <string name="ime_notice">Enkaku input — driven by the farm host</string>
    <string name="open_accessibility_settings">Open accessibility settings</string>
    <string name="accessibility_settings_missing">This device has no accessibility settings screen.</string>
    <string name="ui_tree_service_description">Lets an Enkaku device farm read the on-screen layout for automation, the same way it can already send taps and keys.</string>

    <!-- Controls -->
    <string name="refresh">Refresh</string>
    <string name="copy_report">Copy</string>
    <string name="report_copied">Status copied to the clipboard.</string>
    <string name="status_updated">Updated %1$s · refreshes itself while this screen is open</string>

    <!-- Banner: the one line that must be readable from across the room -->
    <string name="banner_held_title">Traffic is blocked (fail-closed)</string>
    <string name="banner_held_body">The tunnel stopped carrying traffic, so this device is dropping every packet on purpose instead of letting it out on its own address. Nothing on this phone reaches the internet until the farm restores the route. To recover it by hand, turn the VPN off: Settings → Network &amp; internet → VPN → disconnect Enkaku route.</string>
    <string name="banner_stale_tunnel_title">The tunnel outlived the route</string>
    <string name="banner_stale_tunnel_body">This agent has no route configured, but Android still has this app\'s own VPN interface (%1$s) established. Traffic entering it may be going nowhere. Turn the VPN off in Settings → Network &amp; internet → VPN, or have the farm apply a route and stop it again.</string>
    <string name="banner_foreign_vpn_title">Another VPN app is in control</string>
    <string name="banner_foreign_vpn_body">Android has a VPN interface established (%1$s) that this agent did not create. Only one can be active at a time, so the farm cannot route this device until that one is turned off.</string>
    <string name="banner_channel_down_title">The farm cannot reach this agent</string>
    <string name="banner_channel_down_body">The control channel is not listening, so nothing the host sends arrives. It comes back when the host bootstraps the agent again, or after a reboot.</string>
    <string name="banner_up_title">Route up</string>
    <string name="banner_up_body">A tunnel is established and forwarding. That is not proof traffic reaches the intended exit — only an egress check answers that, and only the farm runs one.</string>
    <string name="banner_idle_title">No route</string>
    <string name="banner_idle_body">This device is using its own network. Nothing is being tunnelled.</string>
    <string name="banner_unpaired_title">Not paired</string>
    <string name="banner_unpaired_body">No farm host has handed this agent a token since it started, so every request on the control channel is refused with E_NOT_PAIRED.</string>
    <string name="banner_activity_title">Connected, running</string>
    <string name="banner_activity_body">%1$s</string>
    <string name="banner_controlled_title">Controlled by %1$s</string>
    <string name="banner_controlled_body">A human or an agent is currently in control of this device through the farm.</string>

