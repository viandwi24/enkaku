<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is for the ROUTE, not the control channel — the channel is an abstract-namespace
      unix socket reached through `adb forward` and needs nothing. But the tunnel opens its own
      TCP connection to the SOCKS5 upstream, and without this permission that connection cannot
      even resolve a hostname: every session dies at "socks5 client resolve", the TUN comes up
      carrying nothing, and the browser reports ERR_SOCKET_NOT_CONNECTED while the route claims
      to be active. Cost most of a debugging session to find.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Plan 51 §4.5, §5.7 — Ipv6Leak.isBlocked() reads back LinkProperties/NetworkCapabilities off
      ConnectivityManager to ASSERT the ::/0 route actually landed, rather than trusting the
      Builder call that asked for it. A "normal" permission (no runtime grant dialog), but still
      required to call getAllNetworks()/getNetworkCapabilities()/getLinkProperties().
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Plan 89 §4.5; plan 90 §3.6 — a NORMAL, install-time permission: `adb install -r -g` already
      covers it, so unlike ACTIVATE_VPN and android:mock_location (both `@hide` app-ops needing a
      readback-verified `appops set`), no extra provisioning step is needed for the label facet.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.EnkakuGuestAgent">

        <!--
          Exported because it must be: `adb shell am` cannot reach a component declared
          exported="false" — only root and system bypass the export check, and the shell user is
          neither. Authorisation is a token in the payload instead; a signature-level permission
          would block the shell too, since it is not signed with our key.
          See docs/research/android-guest-agent.md §1.1.

          Launching this once after install is also what clears the stopped state, without which
          BOOT_COMPLETED never arrives (§1.3).
        -->
        <!--
          singleTop is load-bearing, not cosmetic. The host re-bootstraps on every operation with
          a fresh token. Under the default `standard` launch mode, an `am start` aimed at an
          activity already on top merely brings its task forward — neither onCreate nor
          onNewIntent runs — so the very first token would stick and every later one would be
          dropped, leaving the agent answering E_UNAUTHORISED. With singleTop the intent is
          delivered to onNewIntent, which hands the new token over. Diagnosed end-to-end; see
          plan 44 §8b.
        -->
        <activity
            android:name=".BootstrapActivity"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true" />

        <!-- The human-facing screen, behind the launcher icon. Separate from the shim above so a
             machine-driven bootstrap never puts a window in front of the operator. -->
        <activity
            android:name=".StatusActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".control.ControlService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_farm_control_channel" />
        </service>

        <!--
          BIND_VPN_SERVICE is an android:permission ATTRIBUTE on the service, not a
          <uses-permission> — the system holds it, we do not. Not exported: only this app's own
          control channel starts it.
        -->
        <service
            android:name=".route.RouteVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_farm_test_route" />
        </service>

        <!--
          Plan 90 §3.2, §4.2, step 90.5 — the farm's keyboard. `BIND_INPUT_METHOD` is a
          system-held permission attribute (like `RouteVpnService`'s `BIND_VPN_SERVICE` above),
          not a `<uses-permission>` this app declares for itself. `exported="true"` is required
          for the system's IME picker/binder to reach it at all — restricted to callers holding
          `BIND_INPUT_METHOD` regardless. `android.view.im`/`res/xml/method.xml` is the standard
          IME manifest wiring; `settingsActivity` points back at `StatusActivity` so "Language &
          input" settings has somewhere to send a human who taps in from there.
        -->
        <service
            android:name=".input.EnkakuIme"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
