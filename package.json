{
  "name": "openpf",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*",
    "examples"
  ],
  "scripts": {
    "dev": "ENKAKU_DATA_DIR=${ENKAKU_DATA_DIR:-$PWD/.dev-data} bun run packages/core/src/index.ts",
    "dev:studio": "bun run --cwd packages/studio dev",
    "dev:cloud": "ENKAKU_MODE=orchestrator ENKAKU_DATA_DIR=${ENKAKU_DATA_DIR:-$PWD/.dev-cloud} bun run packages/core/src/index.ts",
    "dev:node": "ENKAKU_DATA_DIR=${ENKAKU_DATA_DIR:-$PWD/.dev-node} bun run packages/node/src/cli.ts",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "doctor": "bun run packages/core/src/index.ts doctor",
    "build:studio": "bash scripts/build-studio.sh",
    "build:packs": "bun scripts/build-packs.ts",
    "build:guest-agent": "bash scripts/build-guest-agent.sh",
    "smoke:guest-agent": "bun run scripts/smoke-guest-agent.ts",
    "bench:device-nfrs": "bun run scripts/bench-device-nfrs.ts",
    "probe-server": "bun run packages/probe-server/src/index.ts",
    "dev:probe": "PROBE_HTTP_PORT=${PROBE_HTTP_PORT:-8080} PROBE_GEOIP_UPSTREAM_URL='http://ip-api.com/json/{ip}' bun run packages/probe-server/src/index.ts",
    "publish:example": "bun run packages/sdk/src/cli/index.ts publish examples/hello-no-device.ts",
    "typecheck": "bash scripts/typecheck.sh",
    "spec:check": "bun run scripts/spec-check.ts",
    "reset": "rm -rf .dev-data .dev-cloud .dev-node .dev-agent"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
